# Copy to backend/deploy/.env on the server and fill in every value.
# Never commit the real .env. Generate secrets with:  openssl rand -hex 32

# ---- Domains ----
# Public address of this API + admin dashboard (DNS A record -> this VM's public IP).
API_DOMAIN=api.vistaaram.in
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=contact@vistaaram.in
# Where the storefront is served (Vercel). Used in email links and the Google login callback.
# During staging this is the temporary store address; switch to https://vistaaram.in at cutover.
STOREFRONT_URL=https://store.vistaaram.in

# ---- CORS: comma-separated origins allowed to call the API ----
STORE_CORS=https://store.vistaaram.in
AUTH_CORS=https://store.vistaaram.in,https://api.vistaaram.in
ADMIN_CORS=https://api.vistaaram.in

# ---- Database (Postgres runs in Docker on this VM) ----
POSTGRES_USER=vistaaram
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=vistaaram

# ---- Secrets ----
JWT_SECRET=change-me-openssl-rand-hex-32
COOKIE_SECRET=change-me-openssl-rand-hex-32

# ---- Oracle Object Storage (S3-compatible) for product images ----
# Bucket must be PUBLIC (visibility: Public) so images load on the site.
S3_BUCKET=vistaaram-media
S3_REGION=ap-mumbai-1
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.ap-mumbai-1.oraclecloud.com
# Public URL prefix for objects in the bucket:
S3_FILE_URL=https://objectstorage.ap-mumbai-1.oraclecloud.com/n/NAMESPACE/b/vistaaram-media/o
# Customer Secret Key (Profile -> Customer secret keys in the Oracle console)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Backups (separate PRIVATE bucket; never the public media bucket) ----
BACKUP_BUCKET=vistaaram-backups
BACKUP_RETENTION_DAYS=14

# ---- Optional integrations ----
# Google login (same client as local dev; add https://<store>/auth/google/callback in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transactional email via Resend (password reset, order linking)
RESEND_API_KEY=
EMAIL_FROM=Vistaaram <orders@vistaaram.in>
# Razorpay (leave blank for COD-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
